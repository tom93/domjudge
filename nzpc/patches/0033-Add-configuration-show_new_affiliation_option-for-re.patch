From: Tom Levy <tomlevy93@gmail.com>
Date: Sat, 21 Mar 2020 23:47:51 +1300
Subject: Add configuration 'show_new_affiliation_option' for registration form

Default to true, which matches the existing behaviour.
---
 etc/db-config.yaml                            |  5 +++
 webapp/src/Form/Type/UserRegistrationType.php | 35 +++++++++++--------
 2 files changed, 25 insertions(+), 15 deletions(-)

diff --git a/etc/db-config.yaml b/etc/db-config.yaml
index f7303efc1..0a518c31c 100644
--- a/etc/db-config.yaml
+++ b/etc/db-config.yaml
@@ -184,6 +184,11 @@
             default_value: false
             public: true
             description: Show affiliation logos on the scoreboard?
+        -   name: show_new_affiliation_option
+            type: bool
+            default_value: true
+            public: true
+            description: Allow teams to create new affiliations during self-registration?
         -   name: show_teams_submissions
             type: bool
             default_value: true
diff --git a/webapp/src/Form/Type/UserRegistrationType.php b/webapp/src/Form/Type/UserRegistrationType.php
index 2ae63cf49..bb686c5df 100644
--- a/webapp/src/Form/Type/UserRegistrationType.php
+++ b/webapp/src/Form/Type/UserRegistrationType.php
@@ -133,6 +133,13 @@ class UserRegistrationType extends AbstractType
         }
 
         if ($this->config->get('show_affiliations')) {
+            $affiliationChoices = [];
+            $affiliationChoices['No affiliation'] = 'none';
+            if ($this->config->get('show_new_affiliation_option')) {
+                $affiliationChoices['Add new affiliation'] = 'new';
+            }
+            $affiliationChoices['Use existing affiliation'] = 'existing';
+
             $countries = [];
             foreach (Utils::ALPHA3_COUNTRIES as $alpha3 => $country) {
                 $countries["$country ($alpha3)"] = $alpha3;
@@ -140,16 +147,13 @@ class UserRegistrationType extends AbstractType
 
             $builder
                 ->add('affiliation', ChoiceType::class, [
-                    'choices' => [
-                        'No affiliation' => 'none',
-                        'Add new affiliation' => 'new',
-                        'Use existing affiliation' => 'existing',
-                    ],
+                    'choices' => $affiliationChoices,
                     'expanded' => true,
                     'mapped' => false,
                     'label' => false,
-                ])
-                ->add('affiliationName', TextType::class, [
+                ]);
+            if ($this->config->get('show_new_affiliation_option')) {
+                $builder->add('affiliationName', TextType::class, [
                     'label' => false,
                     'required' => false,
                     'attr' => [
@@ -157,14 +161,15 @@ class UserRegistrationType extends AbstractType
                     ],
                     'mapped' => false,
                 ]);
-            if ($this->config->get('show_flags')) {
-                $builder->add('affiliationCountry', ChoiceType::class, [
-                    'label' => false,
-                    'required' => false,
-                    'mapped' => false,
-                    'choices' => $countries,
-                    'placeholder' => 'No country',
-                ]);
+                if ($this->config->get('show_flags')) {
+                    $builder->add('affiliationCountry', ChoiceType::class, [
+                        'label' => false,
+                        'required' => false,
+                        'mapped' => false,
+                        'choices' => $countries,
+                        'placeholder' => 'No country',
+                    ]);
+                }
             }
             $builder->add('existingAffiliation', EntityType::class, [
                     'class' => TeamAffiliation::class,
