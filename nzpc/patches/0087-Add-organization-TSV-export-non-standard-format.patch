Subject: Add organization TSV export (non-standard format)

---
 .../Jury/ImportExportController.php           | 11 ++++++++--
 webapp/src/Service/ImportExportService.php    | 20 +++++++++++++++++++
 webapp/templates/jury/import_export.html.twig |  2 +-
 3 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/webapp/src/Controller/Jury/ImportExportController.php b/webapp/src/Controller/Jury/ImportExportController.php
index d2f8b22e0..d0e9e9e65 100644
--- a/webapp/src/Controller/Jury/ImportExportController.php
+++ b/webapp/src/Controller/Jury/ImportExportController.php
@@ -216,7 +216,7 @@ class ImportExportController extends BaseController
     }
 
     /**
-     * @Route("/export/{type<groups|teams|scoreboard|results>}.tsv", name="jury_tsv_export")
+     * @Route("/export/{type<groups|organizations-nzpc|teams|scoreboard|results>}.tsv", name="jury_tsv_export")
      * @param Request $request
      * @param string  $type
      * @return RedirectResponse|StreamedResponse
@@ -231,6 +231,9 @@ class ImportExportController extends BaseController
                 case 'groups':
                     $data = $this->importExportService->getGroupData();
                     break;
+                case 'organizations-nzpc':
+                    $data = $this->importExportService->getOrganizationNzpcData();
+                    break;
                 case 'teams':
                     $data = $this->importExportService->getTeamData();
                     break;
@@ -249,7 +252,11 @@ class ImportExportController extends BaseController
 
         $response = new StreamedResponse();
         $response->setCallback(function () use ($type, $version, $data) {
-            echo sprintf("%s\t%s\n", $type, $version);
+            if ($type === 'organizations-nzpc') {
+                // In this format the tsv does not contain a version line.
+            } else {
+                echo sprintf("%s\t%s\n", $type, $version);
+            }
             // output the rows, filtering out any tab characters in the data
             foreach ($data as $row) {
                 echo implode("\t", str_replace("\t", " ", $row)) . "\n";
diff --git a/webapp/src/Service/ImportExportService.php b/webapp/src/Service/ImportExportService.php
index 1bc9e856d..fe49bc892 100644
--- a/webapp/src/Service/ImportExportService.php
+++ b/webapp/src/Service/ImportExportService.php
@@ -261,6 +261,26 @@ class ImportExportService
         return $data;
     }
 
+    /**
+     * Get organization data (NZPC format)
+     * @return array
+     */
+    public function getOrganizationNzpcData(): array
+    {
+        /** @var TeamAffiliation[] $affiliations */
+        $affiliations = $this->em->getRepository(TeamAffiliation::class)->findBy([], ['name' => 'ASC']);
+
+        $data = [];
+        foreach ($affiliations as $affiliation) {
+            $data[] = [
+                $affiliation->getShortname(),
+                $affiliation->getName(),
+            ];
+        }
+
+        return $data;
+    }
+
     /**
      * Get team data
      * @return array
diff --git a/webapp/templates/jury/import_export.html.twig b/webapp/templates/jury/import_export.html.twig
index 90e76232f..75af20fe2 100644
--- a/webapp/templates/jury/import_export.html.twig
+++ b/webapp/templates/jury/import_export.html.twig
@@ -14,7 +14,7 @@
         <li>
             Tab separated, export:
             <ul>
-                {% for type in ['groups', 'teams', 'scoreboard'] %}
+                {% for type in ['groups', 'organizations-nzpc', 'teams', 'scoreboard'] %}
                     <li>
                         <a href="{{ path('jury_tsv_export', {'type': type}) }}"><code>{{ type }}.tsv</code></a>
                     </li>
