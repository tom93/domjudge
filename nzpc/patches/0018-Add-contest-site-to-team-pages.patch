From: Tom Levy <tomlevy93@gmail.com>
Date: Mon, 30 Mar 2020 19:12:47 +1300
Subject: Add contest site to team pages

---
 webapp/src/Controller/Jury/TeamController.php      |  4 +++-
 webapp/src/Form/Type/TeamType.php                  | 12 ++++++++++++
 webapp/templates/jury/partials/team_form.html.twig |  1 +
 webapp/templates/jury/team.html.twig               | 10 ++++++++++
 webapp/templates/partials/team.html.twig           |  6 ++++++
 5 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/webapp/src/Controller/Jury/TeamController.php b/webapp/src/Controller/Jury/TeamController.php
index f343bff6f..d0dbc50c9 100644
--- a/webapp/src/Controller/Jury/TeamController.php
+++ b/webapp/src/Controller/Jury/TeamController.php
@@ -86,10 +86,11 @@ class TeamController extends BaseController
     {
         /** @var Team[] $teams */
         $teams = $this->em->createQueryBuilder()
-            ->select('t', 'c', 'a', 'cat')
+            ->select('t', 'c', 'a', 's', 'cat')
             ->from(Team::class, 't')
             ->leftJoin('t.contests', 'c')
             ->leftJoin('t.affiliation', 'a')
+            ->leftJoin('t.site', 's')
             ->join('t.category', 'cat')
             ->leftJoin('cat.contests', 'cc')
             ->orderBy('cat.sortorder', 'ASC')
@@ -133,6 +134,7 @@ class TeamController extends BaseController
             'name' => ['title' => 'teamname', 'sort' => true, 'default_sort' => true],
             'display_name' => ['title' => 'display name', 'sort' => true, 'default_sort' => true],
             'category' => ['title' => 'category', 'sort' => true,],
+            'site' => ['title' => 'site', 'sort' => true,],
             'affiliation' => ['title' => 'affiliation', 'sort' => true,],
             'team_manager_name' => ['title' => 'team manager', 'sort' => true,],
             'num_contests' => ['title' => '# contests', 'sort' => true,],
diff --git a/webapp/src/Form/Type/TeamType.php b/webapp/src/Form/Type/TeamType.php
index 98ce71410..72ecb7410 100644
--- a/webapp/src/Form/Type/TeamType.php
+++ b/webapp/src/Form/Type/TeamType.php
@@ -3,6 +3,7 @@
 namespace App\Form\Type;
 
 use App\Entity\Contest;
+use App\Entity\ContestSite;
 use App\Entity\Team;
 use App\Entity\TeamAffiliation;
 use App\Entity\TeamCategory;
@@ -55,6 +56,17 @@ class TeamType extends AbstractType
         $builder->add('category', EntityType::class, [
             'class' => TeamCategory::class,
         ]);
+        $builder->add('site', EntityType::class, [
+            'class' => ContestSite::class,
+            'required' => false,
+            'placeholder' => '-- no site --',
+            'query_builder' => function (EntityRepository $er) {
+                return $er->createQueryBuilder('s')
+                    ->orderBy('s.sortorder')
+                    ->addOrderBy('s.name', 'ASC')
+                    ->addOrderBy('s.siteid');
+            },
+        ]);
         $builder->add('members', TextareaType::class, [
             'required' => false,
         ]);
diff --git a/webapp/templates/jury/partials/team_form.html.twig b/webapp/templates/jury/partials/team_form.html.twig
index 5b700d8a6..ddddd6500 100644
--- a/webapp/templates/jury/partials/team_form.html.twig
+++ b/webapp/templates/jury/partials/team_form.html.twig
@@ -5,6 +5,7 @@
         {{ form_row(form.name) }}
         {{ form_row(form.displayName) }}
         {{ form_row(form.category) }}
+        {{ form_row(form.site) }}
         {{ form_row(form.members) }}
         {{ form_row(form.affiliation) }}
         {{ form_row(form.team_manager_name) }}
diff --git a/webapp/templates/jury/team.html.twig b/webapp/templates/jury/team.html.twig
index 0fd8e5912..c80251a03 100644
--- a/webapp/templates/jury/team.html.twig
+++ b/webapp/templates/jury/team.html.twig
@@ -100,6 +100,16 @@
                         </a>
                     </td>
                 </tr>
+                {% if team.site %}
+                    <tr>
+                        <th>Site</th>
+                        <td>
+                            <a href="{{ path('jury_contest_site', {'siteId': team.site.siteid}) }}">
+                                {{ team.site.name }}
+                            </a>
+                        </td>
+                    </tr>
+                {% endif %}
                 {% if showAffiliations and team.affiliation %}
                     <tr>
                         <th>Affiliation</th>
diff --git a/webapp/templates/partials/team.html.twig b/webapp/templates/partials/team.html.twig
index 530de1332..ec12055dd 100644
--- a/webapp/templates/partials/team.html.twig
+++ b/webapp/templates/partials/team.html.twig
@@ -15,6 +15,12 @@
                     <th>Category</th>
                     <td>{{ team.category.name }}</td>
                 </tr>
+                {% if team.site %}
+                    <tr>
+                        <th>Site</th>
+                        <td>{{ team.site.name }}</td>
+                    </tr>
+                {% endif %}
                 {% if showTeamMembers and team.members is not empty %}
                     <tr>
                         <th>Members</th>
