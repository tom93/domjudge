index 7c43dfcc1..8d901bab3 100644
--- a/webapp/src/Form/Type/UserRegistrationType.php
+++ b/webapp/src/Form/Type/UserRegistrationType.php
@@ -175,12 +175,14 @@ class UserRegistrationType extends AbstractType
         }
 
         if ($this->config->get('show_team_members')) {
