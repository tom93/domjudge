Subject: Don't refresh the scoreboard when the filter popup is open

A refresh closes the popup and loses the current changes.
---
 webapp/public/js/domjudge.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/webapp/public/js/domjudge.js b/webapp/public/js/domjudge.js
index a94621c88..a83348bda 100644
--- a/webapp/public/js/domjudge.js
+++ b/webapp/public/js/domjudge.js
@@ -449,7 +449,9 @@ function enableRefresh($url, $after, usingAjax) {
         return;
     }
     var refresh = function () {
-        if (usingAjax) {
+        if ($('#filter-toggle[aria-expanded="true"]').length !== 0) {
+            // don't refresh when the scoreboard filter popup is open
+        } else if (usingAjax) {
             $('.loading-indicator').addClass('ajax-loader');
             $.ajax({
                 url: $url,
