Subject: backport: Add ConfigurationService shim to SecurityController and
 UserRegistrationType

---
 webapp/src/Controller/SecurityController.php  | 8 ++++++++
 webapp/src/Form/Type/UserRegistrationType.php | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/webapp/src/Controller/SecurityController.php b/webapp/src/Controller/SecurityController.php
index 391a7a117..1f29db7b8 100644
--- a/webapp/src/Controller/SecurityController.php
+++ b/webapp/src/Controller/SecurityController.php
@@ -22,6 +22,14 @@ use Symfony\Component\Security\Http\Authentication\AuthenticationUtils;
 
 class SecurityController extends AbstractController
 {
+    // backport: use a shim for the ConfigurationService class (added in DOMjudge 7.3)
+    protected $config;
+    /** @required */
+    public function setConfig(\App\Service\ConfigurationService $config)
+    {
+        $this->config = $config;
+    }
+
     /**
      * @var DOMJudgeService
      */
diff --git a/webapp/src/Form/Type/UserRegistrationType.php b/webapp/src/Form/Type/UserRegistrationType.php
index 37c172642..555327ff8 100644
--- a/webapp/src/Form/Type/UserRegistrationType.php
+++ b/webapp/src/Form/Type/UserRegistrationType.php
@@ -26,6 +26,14 @@ use Symfony\Component\Validator\Context\ExecutionContext;
 
 class UserRegistrationType extends AbstractType
 {
+    // backport: use a shim for the ConfigurationService class (added in DOMjudge 7.3)
+    protected $config;
+    /** @required */
+    public function setConfig(\App\Service\ConfigurationService $config)
+    {
+        $this->config = $config;
+    }
+
     /**
      * @var DOMJudgeService
      */
