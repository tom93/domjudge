Subject: Add contest site to balloon pages

---
 webapp/src/Service/BalloonService.php                 | 3 +++
 webapp/templates/jury/partials/balloon_list.html.twig | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/webapp/src/Service/BalloonService.php b/webapp/src/Service/BalloonService.php
index 66b398144..9921f0499 100644
--- a/webapp/src/Service/BalloonService.php
+++ b/webapp/src/Service/BalloonService.php
@@ -113,6 +113,7 @@ class BalloonService
             ->select('b', 's.submittime', 'p.probid',
                 't.teamid', 't.name AS teamname', 't.room',
                 'c.name AS catname',
+                'site.name AS sitename',
                 's.cid', 'co.shortname',
                 'cp.shortname AS probshortname', 'cp.color',
                 'a.affilid AS affilid', 'a.shortname AS affilshort')
@@ -123,6 +124,7 @@ class BalloonService
             ->leftJoin('p.contest_problems', 'cp', Join::WITH, 'co.cid = cp.contest AND p.probid = cp.problem')
             ->leftJoin('s.team', 't')
             ->leftJoin('t.category', 'c')
+            ->leftJoin('t.site', 'site')
             ->leftJoin('t.affiliation', 'a')
             ->andWhere('co.cid = :cid')
             ->setParameter(':cid', $contest->getCid())
@@ -179,6 +181,7 @@ class BalloonService
             $balloondata['affiliation'] = $balloonsData['affilshort'];
             $balloondata['affiliationid'] = $balloonsData['affilid'];
             $balloondata['category'] = $balloonsData['catname'];
+            $balloondata['site'] = $balloonsData['sitename'];
 
             ksort($TOTAL_BALLOONS[$balloonsData['teamid']]);
             $balloondata['total'] = $TOTAL_BALLOONS[$balloonsData['teamid']];
diff --git a/webapp/templates/jury/partials/balloon_list.html.twig b/webapp/templates/jury/partials/balloon_list.html.twig
index 0e16db170..bf03a786e 100644
--- a/webapp/templates/jury/partials/balloon_list.html.twig
+++ b/webapp/templates/jury/partials/balloon_list.html.twig
@@ -14,6 +14,7 @@
             <th scope="col">team</th>
             <th scope="col">affiliation</th>
             <th scope="col">location</th>
+            <th scope="col">site</th>
             <th scope="col">category</th>
             <th scope="col">total</th>
             <th scope="col">awards</th>
@@ -37,6 +38,7 @@
                 <td>{{ balloon.data.team | truncate(30) }}</td>
                 <td>{{ balloon.data.affiliation }}</td>
                 <td>{{ balloon.data.location }}</td>
+                <td>{{ balloon.data.site }}</td>
                 <td>{{ balloon.data.category }}</td>
                 <td>
                 {%- for totalballoon in balloon.data.total -%}
