diff --git a/webapp/src/Form/Type/UserRegistrationType.php b/webapp/src/Form/Type/UserRegistrationType.php
index b2b9ca562..f4e6aedfc 100644
--- a/webapp/src/Form/Type/UserRegistrationType.php
+++ b/webapp/src/Form/Type/UserRegistrationType.php
@@ -143,7 +143,7 @@ class UserRegistrationType extends AbstractType
                 $specialAffiliationChoices['Add affiliation...'] = 'new';
             }
             $affiliations = [];
-            foreach ($this->em->getRepository(TeamAffiliation::class)->findAll() as $affiliation) {
+            foreach ($this->em->getRepository(TeamAffiliation::class)->findBy([], ['name' => 'ASC']) as $affiliation) {
                 $affiliations[$affiliation->getName()] = $affiliation;
             }
 
