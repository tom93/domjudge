+                ->add('email', EmailType::class, [
+                    'label' => false,
+                    'required' => false,
+                    'attr' => [
+                        'placeholder' => 'Email address (optional)',
+                    ],
+                    'constraints' => new Email(),
+                ]);
+        }
+        $builder
             ->add('teamName', TextType::class, [
                 'label' => false,
                 'attr' => [
