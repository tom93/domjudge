From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Levy <tomlevy93@gmail.com>
Date: Sun, 29 Mar 2020 01:57:26 +1300
Subject: Add configuration option 'show_user_emails'

Default to true, which matches the existing behaviour.
---
 etc/db-config.yaml                            |  5 +++++
 webapp/src/Controller/Jury/UserController.php | 11 ++++++++--
 webapp/src/Form/Type/UserRegistrationType.php | 22 +++++++++++--------
 webapp/templates/jury/user.html.twig          | 22 ++++++++++---------
 4 files changed, 39 insertions(+), 21 deletions(-)

diff --git a/etc/db-config.yaml b/etc/db-config.yaml
index 0a518c31c..2505f364a 100644
--- a/etc/db-config.yaml
+++ b/etc/db-config.yaml
@@ -164,6 +164,11 @@
             default_value: true
             public: true
             description: Show pending submissions on the scoreboard?
+        -   name: show_user_emails
+            type: bool
+            default_value: true
+            public: true
+            description: Show user email addresses in the interfaces?
         -   name: show_team_members
             type: bool
             default_value: true
diff --git a/webapp/src/Controller/Jury/UserController.php b/webapp/src/Controller/Jury/UserController.php
index 30e0873d0..063b5c141 100644
--- a/webapp/src/Controller/Jury/UserController.php
+++ b/webapp/src/Controller/Jury/UserController.php
@@ -102,7 +102,11 @@ class UserController extends BaseController
         $table_fields = [
             'username' => ['title' => 'username', 'sort' => true, 'default_sort' => true],
             'name' => ['title' => 'name', 'sort' => true],
-            'email' => ['title' => 'email', 'sort' => true],
+        ];
+        if ($this->config->get('show_user_emails')) {
+            $table_fields['email'] = ['title' => 'email', 'sort' => true];
+        }
+        $table_fields += [
             'user_roles' => ['title' => 'roles', 'sort' => true],
             'team' => ['title' => 'team', 'sort' => true],
             'status' => ['title' => '', 'sort' => true],
@@ -202,7 +206,10 @@ class UserController extends BaseController
             throw new NotFoundHttpException(sprintf('User with ID %s not found', $userId));
         }
 
-        return $this->render('jury/user.html.twig', ['user' => $user]);
+        return $this->render('jury/user.html.twig', [
+            'user' => $user,
+            'showUserEmails' => (bool)$this->config->get('show_user_emails'),
+        ]);
     }
 
     /**
