From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Levy <tomlevy93@gmail.com>
Date: Wed, 17 Jun 2020 17:30:55 +0000
Subject: cherry-pick: Fix output directory of gen_all_secrets when running
 from a different directory

(cherry picked from commit 9bac55144600b24193e26be94bb7af3e8f315d52)
---
 etc/gen_all_secrets | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/etc/gen_all_secrets b/etc/gen_all_secrets
index feed2315c..e6f6f7e7e 100755
--- a/etc/gen_all_secrets
+++ b/etc/gen_all_secrets
@@ -13,7 +13,7 @@ create_pw_file()
 	[ -n "$QUIET" ] || echo -n "Running '$SCRIPT'... "
 	touch "$FILE"
 	chmod go= "$FILE"
-	$(dirname $0)/$SCRIPT > "$FILE"
+	"./$SCRIPT" > "$FILE"
 	[ -n "$QUIET" ] || echo "file '$FILE' created."
 }
 
@@ -38,6 +38,7 @@ while getopts ':q' OPT ; do
 done
 shift $((OPTIND-1))
 
+cd "$(dirname "$0")"
 create_pw_file gendbpasswords dbpasswords.secret
 create_pw_file genrestapicredentials restapi.secret
 create_pw_file gensymfonysecret symfony_app.secret
-- 
