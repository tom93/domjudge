Subject: Install C# runtime in chroot

---
 misc-tools/dj_make_chroot.in | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/misc-tools/dj_make_chroot.in b/misc-tools/dj_make_chroot.in
index 4b6e6a9c9..0b1676221 100755
--- a/misc-tools/dj_make_chroot.in
+++ b/misc-tools/dj_make_chroot.in
@@ -133,8 +133,7 @@ if [ "$DISTRO" = 'Debian' ]; then
 INCLUDEDEBS="ca-certificates"
 
 # Packages to install after upgrade (space separated):
-INSTALLDEBS="default-jre-headless pypy python3 locales"
-# For C# support add: mono-runtime
+INSTALLDEBS="default-jre-headless pypy python3 locales mono-runtime"
 
 # Packages to remove after upgrade (space separated):
 REMOVEDEBS=""
@@ -161,8 +160,7 @@ if [ "$DISTRO" = 'Ubuntu' ]; then
 INCLUDEDEBS=""
 
 # Packages to install after upgrade (space separated):
-INSTALLDEBS="default-jre-headless pypy python3 locales"
-# For C# support add: mono-runtime
+INSTALLDEBS="default-jre-headless pypy python3 locales mono-runtime"
 
 # Packages to remove after upgrade (space separated):
 REMOVEDEBS=""
