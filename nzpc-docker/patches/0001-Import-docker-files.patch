+  /usr/bin/chfn \
+  /usr/bin/chsh \
+  /usr/bin/expiry \
+  /usr/bin/gpasswd \
+  /usr/bin/passwd \
+  /bin/su \
+  /bin/mount \
+  /bin/umount \
+  /sbin/unix_chkpwd \
+  || true
