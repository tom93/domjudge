From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Levy <tomlevy93@gmail.com>
Date: Fri, 24 Jul 2020 08:00:27 +1200
Subject: Speed up chown in Docker

Recursive chown is slow in Docker because of the copy-on-write
filesystem.[1]

Avoid chown by creating files with correct ownership where possible.

Where it is not possible (specifically "ADD domjudge.tar.gz" because
the owner in the archive is arbitrary and can't be overridden[2]),
optimise the case where the files already have the correct ownership.

[1] https://github.com/docker/for-linux issue 388
[2] https://github.com/moby/moby issue 35525
---
 docker/domserver/Dockerfile       | 14 ++++++++++----
 docker/domserver/build.sh         |  1 -
 docker/domserver/configure.sh     |  4 +---
 docker/judgehost/Dockerfile       |  3 +++
 docker/judgehost/Dockerfile.build |  6 ++++--
 docker/judgehost/build.sh         |  1 -
 docker/judgehost/configure.sh     |  3 ---
 7 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/docker/domserver/Dockerfile b/docker/domserver/Dockerfile
index d39d3e329..5b5534cb1 100644
--- a/docker/domserver/Dockerfile
+++ b/docker/domserver/Dockerfile
@@ -30,11 +30,13 @@ RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
 	&& php composer-setup.php \
 	&& mv /composer.phar /usr/local/bin/composer
 
-# Add DOMjudge source code and build script
+# Add DOMjudge source code
 ADD domjudge.tar.gz /domjudge-src
-COPY domserver/build.sh /domjudge-src/build.sh
+RUN find /domjudge-src/domjudge* '(' ! -user domjudge -o ! -group domjudge ')' -execdir \
+	chown domjudge:domjudge {} +
 
 # Build and install domserver
+COPY domserver/build.sh /domjudge-src/build.sh
 RUN /domjudge-src/build.sh
 
 # Now create an image with the actual build in it
@@ -62,14 +64,18 @@ RUN apt-get update \
 	ca-certificates python3-yaml \
 	&& rm -rf /var/lib/apt/lists/*
 
+# Set up user
+RUN useradd -m domjudge
+
 # Install composer
 RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
 	&& php composer-setup.php \
 	&& mv /composer.phar /usr/local/bin/composer
 
 # Copy domserver
-COPY --from=domserver-build /opt/domjudge/domserver /opt/domjudge/domserver
-COPY --from=domserver-build /opt/domjudge/doc /opt/domjudge/doc
+RUN mkdir /opt/domjudge && chown domjudge: /opt/domjudge
+COPY --from=domserver-build --chown=domjudge /opt/domjudge/domserver /opt/domjudge/domserver
+COPY --from=domserver-build --chown=domjudge /opt/domjudge/doc /opt/domjudge/doc
 
 # Copy scripts
 COPY domserver/scripts /scripts/
diff --git a/docker/domserver/build.sh b/docker/domserver/build.sh
index 8b3c771fa..db1d2fe71 100755
--- a/docker/domserver/build.sh
+++ b/docker/domserver/build.sh
@@ -1,7 +1,6 @@
 #!/bin/sh -eu
 
 cd /domjudge-src/domjudge*
-chown -R domjudge: .
 # If we used a local source tarball, it might not have been built yet
 sudo -u domjudge make dist
 sudo -u domjudge ./configure -with-baseurl=http://localhost/
diff --git a/docker/domserver/configure.sh b/docker/domserver/configure.sh
index 556840463..bd31d9372 100644
--- a/docker/domserver/configure.sh
+++ b/docker/domserver/configure.sh
@@ -1,9 +1,7 @@
 #!/bin/sh -eu
 
-# Add user, create PHP FPM socket dir, change permissions for domjudge directory and fix scripts
-useradd -m domjudge
+# Create PHP FPM socket dir, change permissions for some domjudge directories and fix scripts
 mkdir -p /run/php
-chown -R domjudge: /opt/domjudge
 chown -R www-data: /opt/domjudge/domserver/tmp
 # for DOMjudge <= 7.2 (submitdir was removed in commit DOMjudge/domjudge@d66725038)
 if [ -d /opt/domjudge/domserver/submissions ]
diff --git a/docker/judgehost/Dockerfile b/docker/judgehost/Dockerfile
index 5ec91ffa8..1fcb59624 100644
--- a/docker/judgehost/Dockerfile
+++ b/docker/judgehost/Dockerfile
@@ -20,6 +20,9 @@ RUN apt-get update \
 	gcc g++ default-jre-headless default-jdk-headless ghc fp-compiler \
 	&& rm -rf /var/lib/apt/lists/*
 
+# Set up user
+RUN useradd -m domjudge
+
 # Add chroot and judgehost data
