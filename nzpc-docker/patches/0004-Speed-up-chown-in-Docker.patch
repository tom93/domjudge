 ADD judgehost.tar.gz /
diff --git a/docker/judgehost/Dockerfile.build b/docker/judgehost/Dockerfile.build
index e7d770325..f1a2e56d2 100644
--- a/docker/judgehost/Dockerfile.build
+++ b/docker/judgehost/Dockerfile.build
@@ -25,11 +25,13 @@ RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
 	&& php composer-setup.php \
 	&& mv /composer.phar /usr/local/bin/composer
 
-# Add DOMjudge source code and build script
+# Add DOMjudge source code
 ADD domjudge.tar.gz /domjudge-src
-ADD judgehost/build.sh /domjudge-src
+RUN find /domjudge-src/domjudge* '(' ! -user domjudge -o ! -group domjudge ')' -execdir \
+	chown domjudge:domjudge {} +
 
 # Build and install judgehost
+ADD judgehost/build.sh /domjudge-src
 RUN /domjudge-src/build.sh
 
 # We need to mount proc, which is not possible in "docker build". Thus we need to run this when starting the container
diff --git a/docker/judgehost/build.sh b/docker/judgehost/build.sh
index ad81dbac8..3a8782940 100755
--- a/docker/judgehost/build.sh
+++ b/docker/judgehost/build.sh
@@ -1,7 +1,6 @@
 #!/bin/sh -eu
 
 cd /domjudge-src/domjudge*
-chown -R domjudge: .
 # If we used a local source tarball, it might not have been built yet
 sudo -u domjudge make configure
 sudo -u domjudge ./configure -with-baseurl=http://localhost/
diff --git a/docker/judgehost/configure.sh b/docker/judgehost/configure.sh
index e6766a4e5..013487f7a 100644
--- a/docker/judgehost/configure.sh
+++ b/docker/judgehost/configure.sh
@@ -1,8 +1,5 @@
 #!/bin/bash -e
 
-useradd -m domjudge
-chown -R domjudge: /opt/domjudge
-
 chmod 755 /scripts/start.sh
 for script in /scripts/bin/*
